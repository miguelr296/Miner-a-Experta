{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mina estática, versión 1",
  "description": "Estructura de la mina; las restricciones entre nodos y túneles se comprueban aparte.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nombre", "nodos", "aristas"],
  "properties": {
    "version": {"const": 1, "type": "integer"},
    "nombre": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "nodos": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nodo"}
    },
    "aristas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/arista"}
    }
  },
  "$defs": {
    "identificador": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "nodo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "nivel", "tipo"],
      "properties": {
        "id": {"$ref": "#/$defs/identificador"},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "nivel": {"type": "number"},
        "tipo": {"enum": ["interseccion", "salida", "refugio", "frente"]}
      }
    },
    "arista": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origen", "destino", "longitud_m"],
      "properties": {
        "id": {"$ref": "#/$defs/identificador"},
        "origen": {"$ref": "#/$defs/identificador"},
        "destino": {"$ref": "#/$defs/identificador"},
        "longitud_m": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
